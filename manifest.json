{
  "manifest_version": 3,
  "name": "Element Screenshot",
  "version": "1.8.0",
  "description": "Extensão para o Google Chrome que permite selecionar qualquer elemento de uma página web — imagens, divs, seções inteiras — e salvá-lo como arquivo PNG, sem precisar tirar print da tela.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "/popup/popup.html",
    "default_title": "Element Screenshot",
    "default_icon": "images/icon.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/html2canvas.min.js", "scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}
